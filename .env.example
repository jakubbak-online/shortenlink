# Skopiuj do .env i uzupełnij lokalnie. .env nie jest w repo.

SECRET_KEY=zmien-mnie
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Produkcja z domeną: wpisz samą nazwę domeny (bez https://, bez www.) i
# tyle - dokłada się sama do ALLOWED_HOSTS i CSRF_TRUSTED_ORIGINS
# (settings.py), a Caddy (docker-compose.prod.yml) użyje jej do
# automatycznego HTTPS. Puste = serwowanie po samym IP, bez certyfikatu.
DOMAIN=

DB_NAME=shortenlink
DB_USER=shortenlink
DB_PASSWORD=shortenlink
DB_HOST=db
DB_PORT=5432

# python -c "import secrets; print(secrets.token_hex(32))"
IP_SALT=zmien-mnie

# opcjonalne — bez tego lookup kraju po prostu nic nie zwraca
GEOIP_DB_PATH=geoip/GeoLite2-Country.mmdb

# Redis: baza 0 pod cache Django (przekierowania), baza 1 pod brokera
# Celery — osobne, żeby się nie mieszały
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
